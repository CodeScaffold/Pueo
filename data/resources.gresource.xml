<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <!-- The app icon, found by GTK under <prefix>/icons (see main.rs). -->
  <gresource prefix="/io/github/pueo/Pueo/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="io.github.pueo.Pueo.svg">icons/hicolor/scalable/apps/io.github.pueo.Pueo.svg</file>
  </gresource>
  <!-- Symbolic icons that Adwaita doesn't have. -->
  <gresource prefix="/io/github/pueo/Pueo/icons/scalable/actions">
    <file preprocess="xml-stripblanks">pueo-function-symbolic.svg</file>
    <file preprocess="xml-stripblanks">pueo-key-symbolic.svg</file>
    <!-- Database logos, from Simple Icons (CC0). -->
    <file preprocess="xml-stripblanks">pueo-postgresql-symbolic.svg</file>
    <file preprocess="xml-stripblanks">pueo-mysql-symbolic.svg</file>
    <file preprocess="xml-stripblanks">pueo-sqlite-symbolic.svg</file>
    <file preprocess="xml-stripblanks">pueo-redis-symbolic.svg</file>
  </gresource>
</gresources>
